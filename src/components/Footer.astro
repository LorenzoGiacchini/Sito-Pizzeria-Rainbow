---
// Footer.astro
const currentYear = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
---

<footer id="contatti" class="bg-brand-green text-brand-ivory border-t-4 border-brand-yellow/30 pt-16 pb-12 sm:pb-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- 4-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8 pb-12 border-b border-brand-ivory/15">
      
      <!-- Col 1: Brand & Societari -->
      <div class="space-y-4">
        <div class="flex items-center gap-3.5">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-brand-yellow/60 flex-shrink-0 shadow-lg bg-brand-ivory">
            <img 
              src={`${base}images/logo.png`} 
              alt="Logo Pizzeria Rainbow" 
              class="w-full h-full object-cover" 
              width="80"
              height="80"
              loading="lazy"
            />
          </div>
          <div>
            <span class="text-2xl font-bold text-white tracking-tight">Pizzeria <span class="font-extrabold uppercase tracking-wide">RAINBOW</span></span>
            <p class="text-[11px] text-brand-yellow font-semibold uppercase tracking-wider">Civitavecchia • Dal 2003</p>
          </div>
        </div>

        <p class="text-xs sm:text-sm font-normal text-brand-ivory/80 leading-relaxed">
          Da oltre vent'anni la vera pizza artigianale, primi espressi della tradizione e carne alla brace nel cuore di Civitavecchia.
        </p>

        <!-- Dati Aziendali / Fiscali -->
        <div class="pt-2 text-xs font-normal text-brand-ivory/70 space-y-1">
          <p><strong class="text-white">Ragione Sociale:</strong> Example SRL</p>
          <p><strong class="text-white">P.IVA / C.F.:</strong> 00000000000</p>
          <p><strong class="text-white">Sede Legale:</strong> Via Luigi Sabatini, 2 - 00053 Civitavecchia (RM)</p>
        </div>
      </div>

      <!-- Col 2: Orari di Apertura -->
      <div class="space-y-4">
        <h4 class="font-bold text-lg text-brand-yellow tracking-wide">
          Orari di Apertura
        </h4>

        <!-- Alert dinamico se oggi è festivo -->
        <div id="footer-today-holiday-alert" class="hidden p-2.5 bg-amber-500/20 border border-brand-yellow/60 rounded-xl text-xs text-brand-yellow">
          <p class="font-bold flex items-center gap-1.5">
            <span>⚠️</span> <span id="footer-today-holiday-title">Oggi è festivo</span>
          </p>
          <p class="text-[11px] text-brand-ivory/90 mt-0.5">
            A causa della festività gli orari potrebbero variare.
          </p>
        </div>

        <ul class="text-xs sm:text-sm space-y-2 text-brand-ivory/85" id="footer-schedule-list">
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 transition-colors" data-footer-day="1">
            <div class="flex justify-between items-center">
              <span class="footer-day-label">Lunedì:</span>
              <span class="font-medium text-white">18:30 – 22:30</span>
            </div>
          </li>
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 transition-colors" data-footer-day="2">
            <div class="flex justify-between items-center">
              <span class="footer-day-label">Martedì:</span>
              <span class="font-medium text-white">18:30 – 22:30</span>
            </div>
          </li>
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 text-brand-yellow" data-footer-day="3">
            <div class="flex justify-between items-center">
              <span class="footer-day-label font-bold">Mercoledì:</span>
              <span class="font-bold uppercase tracking-wider bg-brand-terracotta text-white px-2 py-0.5 rounded text-xs">Chiuso</span>
            </div>
          </li>
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 transition-colors" data-footer-day="4">
            <div class="flex justify-between items-center">
              <span class="footer-day-label">Giovedì:</span>
              <span class="font-medium text-white">18:30 – 22:30</span>
            </div>
          </li>
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 transition-colors" data-footer-day="5">
            <div class="flex justify-between items-center">
              <span class="footer-day-label">Venerdì:</span>
              <span class="font-medium text-white">18:30 – 22:30</span>
            </div>
          </li>
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 transition-colors" data-footer-day="6">
            <div class="flex justify-between items-center">
              <span class="footer-day-label">Sabato:</span>
              <span class="font-medium text-white">18:30 – 23:00</span>
            </div>
          </li>
          <li class="flex flex-col py-1 border-b border-brand-ivory/10 transition-colors" data-footer-day="0">
            <div class="flex justify-between items-center">
              <span class="footer-day-label">Domenica:</span>
              <span class="font-medium text-white">18:30 – 22:30</span>
            </div>
          </li>
          <li class="flex flex-col py-2 px-2.5 bg-brand-yellow/15 border border-brand-yellow/40 rounded-lg text-brand-yellow mt-1.5" data-footer-day="festivi">
            <div class="flex justify-between items-center font-bold">
              <span class="flex items-center gap-1.5">
                <span>🎉</span> <span>Giorni Festivi:</span>
              </span>
              <span class="text-[10px] uppercase font-bold tracking-wider bg-brand-yellow text-brand-charcoal px-2 py-0.5 rounded-full">Info</span>
            </div>
            <p class="text-xs text-brand-ivory/95 mt-1 font-medium leading-snug">
              A causa della festività gli orari potrebbero variare
            </p>
          </li>
        </ul>
        <p class="text-[11px] text-brand-ivory/70 italic">
          * Nei giorni festivi gli orari potrebbero variare. Info al <a href="tel:0766370162" class="underline text-brand-yellow">0766 370162</a>.
        </p>
      </div>

      <!-- Col 3: Contatti & Dove Siamo -->
      <div class="space-y-4">
        <h4 class="font-bold text-lg text-brand-yellow tracking-wide">
          Contatti & Asporto
        </h4>
        <div class="space-y-3 text-xs sm:text-sm text-brand-ivory/85">
          <div class="flex items-start gap-2.5">
            <span class="text-base text-brand-yellow">📍</span>
            <span>
              Via Luigi Sabatini, 2<br />
              00053 Civitavecchia (RM)
            </span>
          </div>

          <div class="flex items-start gap-2.5">
            <span class="text-base text-brand-yellow">📞</span>
            <div>
              <p class="text-xs font-normal text-brand-ivory/70">Telefono fisso e asporto:</p>
              <a 
                href="tel:0766370162" 
                class="font-bold text-base text-brand-yellow hover:text-white underline transition-colors"
              >
                0766 370162
              </a>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="https://www.google.com/maps/search/?api=1&query=Via+Luigi+Sabatini+2+00053+Civitavecchia+RM"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-ivory hover:text-brand-yellow underline transition-colors"
            >
              <span>Ottieni indicazioni stradali</span>
              <span>↗</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Col 4: Link Rapidi & Legale -->
      <div class="space-y-4">
        <h4 class="font-bold text-lg text-brand-yellow tracking-wide">
          Navigazione
        </h4>
        <ul class="text-xs sm:text-sm space-y-2.5 text-brand-ivory/85">
          <li>
            <a href={`${base}#hero`} class="hover:text-brand-yellow transition-colors flex items-center gap-1.5">
              <span>›</span> <span>Home</span>
            </a>
          </li>
          <li>
            <a href={`${base}#chi-siamo`} class="hover:text-brand-yellow transition-colors flex items-center gap-1.5">
              <span>›</span> <span>Chi Siamo & Storia</span>
            </a>
          </li>
          <li>
            <a href={`${base}#menu`} class="hover:text-brand-yellow transition-colors flex items-center gap-1.5">
              <span>›</span> <span>Il Menù con Prezzi</span>
            </a>
          </li>
          <li>
            <a href={`${base}#prenotazioni`} class="hover:text-brand-yellow transition-colors flex items-center gap-1.5">
              <span>›</span> <span>Prenotazioni & Asporto</span>
            </a>
          </li>
          <li>
            <a href={`${base}#dove-siamo`} class="hover:text-brand-yellow transition-colors flex items-center gap-1.5">
              <span>›</span> <span>Dove Siamo</span>
            </a>
          </li>
          <li class="pt-2 border-t border-brand-ivory/15">
            <a 
              href={`${base}privacy-policy`} 
              class="text-brand-yellow hover:underline transition-colors font-medium flex items-center gap-1.5"
            >
              <span>🔒</span> <span>Privacy & Cookie Policy</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-brand-ivory/60 gap-4">
      <p>
        © {currentYear} Pizzeria Rainbow • Example SRL - P.IVA 00000000000 - Civitavecchia (RM). Tutti i diritti riservati.
      </p>
      <div class="flex items-center gap-4">
        <a href={`${base}privacy-policy`} class="hover:text-brand-ivory underline transition-colors">Privacy & Cookie Policy</a>
        <span>•</span>
        <span>Sito Informativo No-Ecommerce</span>
      </div>
    </div>

  </div>
</footer>

<script>
  import { checkHoliday, getWeekHolidays } from '../utils/holidays';

  const today = new Date();
  const todayDay = today.getDay(); // 0 = Domenica, 1 = Lunedì, ..., 6 = Sabato

  const urlParams = new URLSearchParams(window.location.search);
  const isTestSimulated = urlParams.get('festivo') === '1' || urlParams.get('festivo') === 'true';

  const todayHolidayInfo = isTestSimulated
    ? { isHoliday: true, name: 'Giorno Festivo' }
    : checkHoliday(today);

  // 1. Evidenzia giorno corrente nel footer
  const currentFooterDayEl = document.querySelector<HTMLLIElement>(`#footer-schedule-list [data-footer-day="${todayDay}"]`);
  if (currentFooterDayEl) {
    currentFooterDayEl.classList.add('bg-white/10', 'rounded-md', 'px-1.5');
    const labelSpan = currentFooterDayEl.querySelector('.footer-day-label');
    if (labelSpan && !labelSpan.querySelector('.footer-today-badge')) {
      const todayBadge = document.createElement('span');
      todayBadge.className = 'footer-today-badge text-[9px] font-bold uppercase bg-brand-yellow text-brand-charcoal px-1.5 py-0.5 rounded ml-1.5 inline-block';
      todayBadge.textContent = 'Oggi';
      labelSpan.appendChild(todayBadge);
    }
  }

  // 2. Controlla festività della settimana
  const weekHolidays = getWeekHolidays(today);
  if (isTestSimulated && !weekHolidays.has(todayDay)) {
    const formattedDate = `${String(today.getDate()).padStart(2, '0')}/${String(today.getMonth() + 1).padStart(2, '0')}`;
    weekHolidays.set(todayDay, { name: 'Giorno Festivo', dateStr: formattedDate });
  }

  weekHolidays.forEach((holiday, dayOfWeek) => {
    const dayEl = document.querySelector<HTMLLIElement>(`#footer-schedule-list [data-footer-day="${dayOfWeek}"]`);
    if (dayEl) {
      dayEl.classList.add('bg-brand-yellow/15', 'border', 'border-brand-yellow/40', 'rounded-md', 'px-1.5');
      
      const labelSpan = dayEl.querySelector('.footer-day-label');
      if (labelSpan && !dayEl.querySelector('.footer-holiday-badge')) {
        const badge = document.createElement('span');
        badge.className = 'footer-holiday-badge text-[9px] font-bold bg-brand-yellow text-brand-charcoal px-1.5 py-0.5 rounded ml-1 inline-block';
        badge.textContent = `🎉 ${holiday.name}`;
        labelSpan.appendChild(badge);
      }

      if (!dayEl.querySelector('.footer-holiday-notice')) {
        const notice = document.createElement('div');
        notice.className = 'footer-holiday-notice text-[11px] text-brand-yellow font-medium mt-0.5 leading-tight';
        notice.textContent = '⚠️ A causa della festività gli orari potrebbero variare';
        dayEl.appendChild(notice);
      }
    }
  });

  // 3. Se oggi è festivo, mostra il banner informativo anche nel footer
  if (todayHolidayInfo.isHoliday) {
    const banner = document.getElementById('footer-today-holiday-alert');
    const title = document.getElementById('footer-today-holiday-title');
    if (banner && title) {
      title.textContent = `Oggi è festivo (${todayHolidayInfo.name})`;
      banner.classList.remove('hidden');
    }
  }
</script>