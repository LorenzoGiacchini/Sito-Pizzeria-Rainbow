// Header.astro
---
const base = import.meta.env.BASE_URL;
---

<header class="sticky top-0 z-50 bg-brand-ivory/95 backdrop-blur-md border-b border-brand-green/10 shadow-sm transition-all duration-300" id="site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between min-h-[6.5rem] py-2.5">

      <!-- Brand Logo & Identity -->
      <a href={`${base}#`} class="flex items-center gap-3 sm:gap-5 group focus:outline-none focus:ring-2 focus:ring-brand-terracotta rounded-2xl p-1 py-1" aria-label="Pizzeria Rainbow Home">
        <div id="brand-logo-container" class="w-24 h-24 sm:w-28 sm:h-28 lg:w-32 lg:h-32 rounded-full overflow-hidden border-3 sm:border-4 border-brand-yellow shadow-2xl group-hover:scale-105 group-hover:rotate-1 transition-all duration-300 flex-shrink-0 bg-brand-green ring-4 ring-brand-yellow/20 relative z-10 -my-3 sm:-my-4">
          <img 
            src={`${base}images/logo.jpeg`} 
            alt="Logo Pizzeria Rainbow Civitavecchia" 
            class="w-full h-full object-cover object-center"
            width="128"
            height="128"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight leading-none flex items-center gap-1.5">
            <span class="text-brand-terracotta group-hover:text-brand-green transition-colors">Pizzeria</span> <span class="text-brand-green group-hover:text-brand-terracotta uppercase tracking-wide transition-colors">RAINBOW</span>
          </span>
          <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-brand-charcoal/80 mt-1 flex items-center gap-1.5">
            <span class="inline-block w-2 h-2 rounded-full bg-brand-yellow"></span>
            Civitavecchia • Dal 2003
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navigazione principale">
        <a 
          href={`${base}#hero`} 
          class="text-sm font-semibold text-brand-charcoal hover:text-brand-terracotta transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-terracotta hover:after:w-full after:transition-all after:duration-200"
        >
          Home
        </a>
        <a 
          href={`${base}#chi-siamo`} 
          class="text-sm font-semibold text-brand-charcoal hover:text-brand-terracotta transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-terracotta hover:after:w-full after:transition-all after:duration-200"
        >
          Chi Siamo
        </a>
        <a 
          href={`${base}#menu`} 
          class="text-sm font-semibold text-brand-charcoal hover:text-brand-terracotta transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-terracotta hover:after:w-full after:transition-all after:duration-200"
        >
          Menù
        </a>
        <a 
          href={`${base}#dove-siamo`} 
          class="text-sm font-semibold text-brand-charcoal hover:text-brand-terracotta transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-terracotta hover:after:w-full after:transition-all after:duration-200"
        >
          Dove Siamo
        </a>
        <a 
          href={`${base}#contatti`} 
          class="text-sm font-semibold text-brand-charcoal hover:text-brand-terracotta transition-colors py-1 relative after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-brand-terracotta hover:after:w-full after:transition-all after:duration-200"
        >
          Contatti
        </a>
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-4">
        <a
          href="tel:0766370162"
          id="header-desktop-call-btn"
          class="inline-flex items-center gap-2.5 bg-brand-terracotta hover:bg-[#b04630] text-white px-5 py-2.5 rounded-full font-bold text-sm tracking-wide shadow-md hover:shadow-warm-hover transform hover:-translate-y-0.5 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-brand-terracotta"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1zM19 12h2c0-4.97-4.03-9-9-9v2c3.87 0 7 3.13 7 7zm-4 0h2c0-2.76-2.24-5-5-5v2c1.66 0 3 1.34 3 3z"/>
          </svg>
          <span>Chiama Ora • 0766 370162</span>
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center md:hidden">
        <button
          type="button"
          id="mobile-menu-button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Apri o chiudi il menu di navigazione"
          class="inline-flex items-center justify-center p-2 rounded-lg text-brand-green hover:text-brand-terracotta hover:bg-brand-green/5 focus:outline-none focus:ring-2 focus:ring-brand-terracotta transition-colors"
        >
          <svg id="hamburger-icon" class="block h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer / Menu -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-t border-brand-green/10 bg-brand-ivory px-4 pt-3 pb-6 shadow-xl transition-all duration-300 ease-in-out"
  >
    <div class="flex flex-col space-y-3 pt-2">
      <a 
        href={`${base}#hero`} 
        class="mobile-nav-link text-base font-semibold text-brand-charcoal hover:text-brand-terracotta hover:bg-brand-green/5 px-3 py-2 rounded-lg transition-colors"
      >
        Home
      </a>
      <a 
        href={`${base}#chi-siamo`} 
        class="mobile-nav-link text-base font-semibold text-brand-charcoal hover:text-brand-terracotta hover:bg-brand-green/5 px-3 py-2 rounded-lg transition-colors"
      >
        Chi Siamo
      </a>
      <a 
        href={`${base}#menu`} 
        class="mobile-nav-link text-base font-semibold text-brand-charcoal hover:text-brand-terracotta hover:bg-brand-green/5 px-3 py-2 rounded-lg transition-colors"
      >
        Menù
      </a>
      <a 
        href={`${base}#dove-siamo`} 
        class="mobile-nav-link text-base font-semibold text-brand-charcoal hover:text-brand-terracotta hover:bg-brand-green/5 px-3 py-2 rounded-lg transition-colors"
      >
        Dove Siamo
      </a>
      <a 
        href={`${base}#contatti`} 
        class="mobile-nav-link text-base font-semibold text-brand-charcoal hover:text-brand-terracotta hover:bg-brand-green/5 px-3 py-2 rounded-lg transition-colors"
      >
        Contatti
      </a>

      <!-- Mobile Call CTA inside drawer -->
      <div class="pt-3 border-t border-brand-green/10">
        <a
          href="tel:0766370162"
          class="w-full flex items-center justify-center gap-2 bg-brand-terracotta hover:bg-[#b04630] text-white py-3 px-4 rounded-xl font-bold shadow-md active:scale-95 transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-0.6-.4-1-1-1z"/>
          </svg>
          <span>Chiama Ora: 0766 370162</span>
        </a>
        <p class="text-xs text-center text-brand-charcoal/70 mt-2 font-medium">
          Aperti stasera • Prenotazioni & Asporto
        </p>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Hamburger Toggle Logic
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  function toggleMenu() {
    const isExpanded = menuButton?.getAttribute('aria-expanded') === 'true';
    menuButton?.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    hamburgerIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  }

  function closeMenu() {
    menuButton?.setAttribute('aria-expanded', 'false');
    mobileMenu?.classList.add('hidden');
    hamburgerIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  }

  menuButton?.addEventListener('click', toggleMenu);

  navLinks.forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Header & Logo shrink on scroll effect
  const logoContainer = document.getElementById('brand-logo-container');
  const siteHeader = document.getElementById('site-header');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      logoContainer?.classList.remove('w-24', 'h-24', 'sm:w-28', 'sm:h-28', 'lg:w-32', 'lg:h-32');
      logoContainer?.classList.add('w-16', 'h-16', 'sm:w-20', 'sm:h-20', 'lg:w-20', 'lg:h-20');
      siteHeader?.classList.add('shadow-md');
    } else {
      logoContainer?.classList.add('w-24', 'h-24', 'sm:w-28', 'sm:h-28', 'lg:w-32', 'lg:h-32');
      logoContainer?.classList.remove('w-16', 'h-16', 'sm:w-20', 'sm:h-20', 'lg:w-20', 'lg:h-20');
      siteHeader?.classList.remove('shadow-md');
    }
  }, { passive: true });
</script>