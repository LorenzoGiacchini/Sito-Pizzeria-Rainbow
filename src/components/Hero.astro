---
// Hero.astro
const base = import.meta.env.BASE_URL;
---

<section id="hero" class="relative overflow-hidden bg-brand-green text-brand-ivory pt-8 pb-16 lg:pt-16 lg:pb-24">
  <!-- Subtle decorative background pattern -->
  <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#E1B04B_1px,transparent_1px)] [background-size:20px_20px]"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-start text-left space-y-6">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-yellow/15 border border-brand-yellow/30 text-brand-yellow text-xs sm:text-sm font-semibold tracking-wide backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-brand-yellow animate-pulse"></span>
          <span>La vera pizza e cucina tradizionale a Civitavecchia</span>
        </div>

        <!-- Main H1 Heading (ExtraBold) -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-brand-ivory leading-[1.15]">
          Il Gusto della Tradizione, <br class="hidden sm:inline" />
          <span class="text-brand-yellow">dal Nostro Forno</span> alla Tua Tavola.
        </h1>

        <!-- Subtitle (Regular) -->
        <p class="text-base sm:text-lg lg:text-xl text-brand-ivory/85 max-w-2xl font-normal leading-relaxed">
          Un’atmosfera calda, accogliente e informale dove sentirsi a casa. 
          Pizze fragranti ad alta digeribilità, primi piatti della vera tradizione e carne alla brace per famiglie, coppie e serate tra amici.
        </p>

        <!-- 2 Distinct Call to Actions: Direct Call & Browse Menu -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto pt-2">
          <!-- CTA 1: Prenota o Ordina al Telefono -->
          <a
            href="tel:0766370162"
            id="hero-book-table-btn"
            class="inline-flex items-center justify-center gap-3 bg-brand-terracotta hover:bg-[#b04630] text-white px-7 py-4 rounded-xl font-bold text-base shadow-lg hover:shadow-warm-hover transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-yellow"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
            </svg>
            <span>Prenota o Ordina • 0766 370162</span>
          </a>

          <!-- CTA 2: Consulta il Menù (azione complementare reale) -->
          <a
            href="#menu"
            id="hero-view-menu-btn"
            class="inline-flex items-center justify-center gap-2.5 bg-brand-ivory hover:bg-white text-brand-green px-7 py-4 rounded-xl font-bold text-base shadow-md hover:shadow-lg transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-yellow"
          >
            <span>Consulta il Menù</span>
            <span class="text-brand-terracotta text-lg">↓</span>
          </a>
        </div>

        <!-- Reassurance & Highlights Row -->
        <div class="pt-4 border-t border-brand-ivory/15 grid grid-cols-2 sm:grid-cols-3 gap-4 w-full">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-yellow flex-shrink-0">
              ✓
            </div>
            <span class="text-xs sm:text-sm text-brand-ivory/90 font-medium">Lievitazione 48h</span>
          </div>

          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-yellow flex-shrink-0">
              ✓
            </div>
            <span class="text-xs sm:text-sm text-brand-ivory/90 font-medium">Pasta & Carne</span>
          </div>

          <div class="flex items-center gap-2.5 col-span-2 sm:col-span-1">
            <div class="w-8 h-8 rounded-full bg-brand-yellow/20 flex items-center justify-center text-brand-yellow flex-shrink-0">
              ✓
            </div>
            <span class="text-xs sm:text-sm text-brand-ivory/90 font-medium">Via Luigi Sabatini, 2</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Decorative Glow / Backdrop -->
          <div class="absolute -top-6 -right-6 w-72 h-72 bg-brand-yellow/20 rounded-full blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-8 -left-8 w-72 h-72 bg-brand-terracotta/20 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Main Image Frame with Warm Shadow -->
          <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-brand-ivory/20 group">
            <!-- Seal / Crest Badge over the image celebrating the brand -->
            <div class="absolute top-4 left-4 z-20 flex items-center gap-3 bg-brand-ivory/95 backdrop-blur-md px-3.5 py-2 rounded-2xl shadow-xl border border-brand-yellow/60">
              <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-brand-yellow shadow-md flex-shrink-0 bg-brand-ivory">
                <img 
                  src={`${base}images/logo.png`} 
                  alt="Logo Pizzeria Rainbow" 
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="flex flex-col pr-1">
                <span class="text-xs font-black uppercase text-brand-green tracking-wide leading-none">Autentica Pizzeria</span>
                <span class="text-[11px] font-bold text-brand-terracotta leading-tight">Pizzeria Rainbow</span>
              </div>
            </div>

            <img 
              src={`${base}images/hero.jpg`} 
              alt="Atmosfera calda della Pizzeria Rainbow a Civitavecchia con pizza appena sfornata" 
              class="w-full h-80 sm:h-96 lg:h-[460px] object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/80 via-transparent to-transparent"></div>

            <!-- Floating In-Picture Badge -->
            <div class="absolute bottom-4 left-4 right-4 bg-brand-ivory/95 backdrop-blur-md text-brand-charcoal p-4 rounded-xl shadow-lg border border-brand-yellow/40">
              <p class="text-xs font-semibold uppercase tracking-wider text-brand-terracotta">Civitavecchia (RM)</p>
              <p class="font-bold text-base sm:text-lg text-brand-green">Pizze, Primi & Brace</p>
              <p class="text-xs font-normal text-brand-charcoal/75 mt-0.5">Tavoli accoglienti e servizio asporto rapido</p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>