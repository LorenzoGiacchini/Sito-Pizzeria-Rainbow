---
// LocationMap.astro
const address = "Via Luigi Sabatini, 2, 00053 Civitavecchia (RM)";
const googleMapsUrl = "https://www.google.com/maps/search/?api=1&query=Via+Luigi+Sabatini+2+00053+Civitavecchia+RM";
const mapEmbedUrl = "https://maps.google.com/maps?q=Via%20Luigi%20Sabatini,%202,%2000053%20Civitavecchia%20RM&t=&z=16&ie=UTF8&iwloc=&output=embed";
---

<section id="dove-siamo" class="py-16 sm:py-24 bg-brand-ivory relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title (ExtraBold for titles) -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-green/10 text-brand-green text-xs sm:text-sm font-semibold uppercase tracking-wider">
        <span>Posizione & Indicazioni</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-brand-green tracking-tight">
        Dove Siamo a Civitavecchia
      </h2>
      <p class="text-brand-charcoal/80 text-base sm:text-lg font-normal">
        Vieni a trovarci nel cuore di Civitavecchia. Ti aspettiamo con il profumo della pizza appena sfornata!
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Info, Parking & Directions -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6 bg-white rounded-3xl p-8 border border-brand-green/15 shadow-warm">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-brand-green text-brand-yellow flex items-center justify-center flex-shrink-0 shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <!-- Titolo secondario (Bold) -->
              <h3 class="font-bold text-xl text-brand-green">Indirizzo</h3>
              <p class="text-base text-brand-charcoal font-semibold mt-1">
                {address}
              </p>
              <p class="text-xs font-normal text-brand-charcoal/70 mt-0.5">
                Zona centrale, a pochi minuti a piedi dal porto e dal lungomare
              </p>
            </div>
          </div>

          <!-- Practical Directions -->
          <div class="space-y-3 pt-4 border-t border-brand-charcoal/10 text-sm">
            <h4 class="font-bold text-brand-green text-sm uppercase tracking-wider">Come Raggiungerci:</h4>
            
            <div class="flex items-start gap-3">
              <span class="text-base">🚶</span>
              <p class="text-brand-charcoal/80">
                <strong>A piedi:</strong> Facile passeggiata dal centro storico, dalla stazione ferroviaria o dai varchi portuali.
              </p>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-base">🚗</span>
              <p class="text-brand-charcoal/80">
                <strong>In auto & Parcheggio:</strong> Comodi stalli di sosta lungo le vie limitrofe a via Luigi Sabatini.
              </p>
            </div>
          </div>
        </div>

        <!-- Direct Google Maps Navigation Button -->
        <div class="pt-6 border-t border-brand-charcoal/10">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="open-google-maps-btn"
            class="w-full inline-flex items-center justify-center gap-3 bg-brand-green hover:bg-[#233a2e] text-white py-4 px-6 rounded-2xl font-bold text-base shadow-md hover:shadow-lg transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
          >
            <!-- Map Pin Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Apri in Google Maps</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Responsive Interactive Map Embed -->
      <div class="lg:col-span-7 rounded-3xl overflow-hidden shadow-warm border border-brand-green/15 min-h-[380px] lg:min-h-[460px] bg-slate-100 relative">
        <iframe
          title="Mappa Pizzeria Rainbow a Civitavecchia"
          src={mapEmbedUrl}
          width="100%"
          height="100%"
          style="border:0; min-height: 400px;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="w-full h-full"
        ></iframe>
      </div>

    </div>

  </div>
</section>
