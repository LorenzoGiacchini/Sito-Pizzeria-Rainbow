---
// LocationMap.astro
import { SITE_CONFIG } from '../utils/siteConfig';

const address = SITE_CONFIG.address.streetAddress + ", " + SITE_CONFIG.address.postalCode + " " + SITE_CONFIG.address.addressLocality + " (" + SITE_CONFIG.address.addressRegion + ")";
const googleMapsUrl = SITE_CONFIG.googleMapsUrl;
const phone = SITE_CONFIG.displayPhone;
---

<section id="dove-siamo" class="py-16 sm:py-24 bg-brand-ivory relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Title (ExtraBold for titles) -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-green/10 text-brand-green text-xs sm:text-sm font-semibold uppercase tracking-wider">
        <span>Posizione & Indicazioni</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-brand-green tracking-tight">
        Dove Siamo a Civitavecchia
      </h2>
      <p class="text-brand-charcoal/80 text-base sm:text-lg font-normal">
        Vieni a trovarci nel cuore di Civitavecchia. Ti aspettiamo con il calore della nostra sala e il profumo della pizza appena sfornata!
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Info, Parking & Directions -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-6 bg-white rounded-3xl p-6 sm:p-8 border border-brand-green/15 shadow-warm">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-2xl bg-brand-green text-brand-yellow flex items-center justify-center flex-shrink-0 shadow-md">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-xl text-brand-green">Indirizzo del Locale</h3>
              <p class="text-base text-brand-charcoal font-semibold mt-1">
                {address}
              </p>
              <p class="text-xs font-normal text-brand-charcoal/70 mt-0.5">
                Zona residenziale centrale (Borgo Odescalchi), a breve distanza dal centro storico, dalla stazione FS e dal porto
              </p>
            </div>
          </div>

          <!-- Contact Phone Quick Box -->
          <div class="flex items-start gap-4 pt-4 border-t border-brand-charcoal/10">
            <div class="w-10 h-10 rounded-xl bg-brand-terracotta/10 text-brand-terracotta flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h4 class="font-bold text-sm text-brand-green">Assistenza Telefonica & Info</h4>
              <a href={`tel:${phone.replace(/\s+/g, '')}`} class="text-base font-bold text-brand-terracotta hover:underline">
                {phone}
              </a>
              <p class="text-xs text-brand-charcoal/70">
                Chiamaci se non trovi la strada o vuoi informazioni sulla disponibilità.
              </p>
            </div>
          </div>

          <!-- Practical Directions -->
          <div class="space-y-3 pt-4 border-t border-brand-charcoal/10 text-sm">
            <h4 class="font-bold text-brand-green text-sm uppercase tracking-wider">Come Raggiungerci:</h4>
            
            <div class="flex items-start gap-3">
              <span class="text-base">🚶</span>
              <p class="text-brand-charcoal/80">
                <strong>A piedi:</strong> Facile passeggiata dal centro storico, dalla stazione ferroviaria o dai varchi portuali.
              </p>
            </div>

            <div class="flex items-start gap-3">
              <span class="text-base">🚗</span>
              <p class="text-brand-charcoal/80">
                <strong>In auto & Parcheggio:</strong> Comodi stalli di sosta lungo Via Luigi Sabatini e nelle vie limitrofe del centro cittadino.
              </p>
            </div>
          </div>
        </div>

        <!-- External Google Maps Navigation Button -->
        <div class="pt-6 border-t border-brand-charcoal/10">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="open-google-maps-btn"
            class="w-full inline-flex items-center justify-center gap-3 bg-brand-green hover:bg-[#233a2e] text-white py-4 px-6 rounded-2xl font-bold text-base shadow-md hover:shadow-lg transform hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-brand-terracotta"
            aria-label="Apri le indicazioni stradali in Google Maps in una nuova scheda"
          >
            <!-- Map Pin Icon -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span>Apri in Google Maps</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 opacity-80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Rich Interactive-Style Location Card (Zero Tracking, Zero External iFrames) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-10 border border-brand-green/15 shadow-warm flex flex-col justify-between space-y-6">
        
        <!-- Header of Location Card -->
        <div class="space-y-3">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-yellow/20 text-brand-charcoal text-xs font-bold uppercase tracking-wider">
              <span>📍</span> <span>Civitavecchia Centro</span>
            </span>
            <span class="text-xs text-brand-charcoal/60 font-medium">
              Coordinate: {SITE_CONFIG.geo.latitude}° N, {SITE_CONFIG.geo.longitude}° E
            </span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-extrabold text-brand-green">
            Pizzeria Rainbow • Civitavecchia
          </h3>
          <p class="text-sm sm:text-base text-brand-charcoal/80 leading-relaxed">
            Situata a Civitavecchia in Via Luigi Sabatini 2, la nostra pizzeria è facilmente raggiungibile sia a piedi dal centro che in auto o con i mezzi dai principali accessi stradali e portuali.
          </p>
        </div>

        <!-- Distance and Landmark Highlights (Percorsi Pedonali Verificati) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 pt-2">
          
          <!-- 1. Varco Fortezza (Porto Storico) -->
          <div class="p-4 rounded-2xl bg-brand-ivory border border-brand-green/10 flex flex-col justify-between">
            <div>
              <div class="text-2xl mb-1">🚢</div>
              <h4 class="font-bold text-brand-green text-sm">Porto — Varco Fortezza</h4>
              <p class="text-xs text-brand-charcoal/70 mt-1">Accesso pedonale porto storico e Forte Michelangelo</p>
            </div>
            <div class="mt-3">
              <p class="text-xs font-bold text-brand-terracotta">~1,4 km (circa 19 min a piedi)</p>
              <p class="text-[10px] text-brand-charcoal/55 mt-0.5">Linea d'aria: ~1,1 km</p>
            </div>
          </div>

          <!-- 2. Largo della Pace (Hub Navette Crociere) -->
          <div class="p-4 rounded-2xl bg-brand-ivory border border-brand-green/10 flex flex-col justify-between">
            <div>
              <div class="text-2xl mb-1">🛳️</div>
              <h4 class="font-bold text-brand-green text-sm">Hub Crociere — Largo della Pace</h4>
              <p class="text-xs text-brand-charcoal/70 mt-1">Terminal navette crocieristi (Port Mobility)</p>
            </div>
            <div class="mt-3">
              <p class="text-xs font-bold text-brand-terracotta">~2,0 km (27 min a piedi • 5 min auto)</p>
              <p class="text-[10px] text-brand-charcoal/55 mt-0.5">Linea d'aria: ~1,8 km</p>
            </div>
          </div>

          <!-- 3. Stazione Ferroviaria FS -->
          <div class="p-4 rounded-2xl bg-brand-ivory border border-brand-green/10 flex flex-col justify-between">
            <div>
              <div class="text-2xl mb-1">🚆</div>
              <h4 class="font-bold text-brand-green text-sm">Stazione Ferroviaria FS</h4>
              <p class="text-xs text-brand-charcoal/70 mt-1">Piazzale Scipione Matteuzzi • Treni Roma/litorale</p>
            </div>
            <div class="mt-3">
              <p class="text-xs font-bold text-brand-terracotta">~1,45 km (circa 19 min a piedi)</p>
              <p class="text-[10px] text-brand-charcoal/55 mt-0.5">Linea d'aria: ~600 m (percorso attorno ai binari)</p>
            </div>
          </div>

          <!-- 4. Corso Centocelle -->
          <div class="p-4 rounded-2xl bg-brand-ivory border border-brand-green/10 flex flex-col justify-between">
            <div>
              <div class="text-2xl mb-1">🛍️</div>
              <h4 class="font-bold text-brand-green text-sm">Corso Centocelle</h4>
              <p class="text-xs text-brand-charcoal/70 mt-1">Isola pedonale centrale e via dello shopping</p>
            </div>
            <div class="mt-3">
              <p class="text-xs font-bold text-brand-terracotta">~1,0 km (circa 13 min a piedi)</p>
              <p class="text-[10px] text-brand-charcoal/55 mt-0.5">Tratto centrale: ~1,15 km (15 min)</p>
            </div>
          </div>

          <!-- 5. Piazza Fratti (Ghetto) -->
          <div class="p-4 rounded-2xl bg-brand-ivory border border-brand-green/10 flex flex-col justify-between">
            <div>
              <div class="text-2xl mb-1">🏛️</div>
              <h4 class="font-bold text-brand-green text-sm">Piazza Fratti (Ghetto)</h4>
              <p class="text-xs text-brand-charcoal/70 mt-1">Area pedonale storica e cuore del ritrovo serale</p>
            </div>
            <div class="mt-3">
              <p class="text-xs font-bold text-brand-terracotta">~1,25 km (circa 16-17 min a piedi)</p>
              <p class="text-[10px] text-brand-charcoal/55 mt-0.5">Linea d'aria: ~1,0 km</p>
            </div>
          </div>

          <!-- 6. Percorsi Verificati (Badge Trasparenza) -->
          <div class="p-4 rounded-2xl bg-brand-green/5 border border-brand-green/15 flex flex-col justify-between">
            <div>
              <div class="text-2xl mb-1">🧭</div>
              <h4 class="font-bold text-brand-green text-sm">Percorsi Verificati</h4>
              <p class="text-xs text-brand-charcoal/70 mt-1">Distanze a piedi reali calcolate da Via Luigi Sabatini 2</p>
            </div>
            <div class="mt-3">
              <p class="text-xs font-bold text-brand-green flex items-center gap-1">
                <span>✓</span> Rete pedonale OpenStreetMap / OSRM
              </p>
              <p class="text-[10px] text-brand-charcoal/55 mt-0.5">Distanze effettive su strada, non stime generiche</p>
            </div>
          </div>

        </div>

        <!-- Orari e Privacy Reminder Box -->
        <div class="space-y-3 pt-2">
          <div class="p-4 bg-brand-green/5 rounded-2xl border border-brand-green/10 flex items-start gap-3.5">
            <span class="text-xl flex-shrink-0">🛡️</span>
            <div class="text-xs sm:text-sm text-brand-charcoal/80 space-y-1">
              <p class="font-bold text-brand-green">Tutela della privacy (Privacy by Design):</p>
              <p>
                Non carichiamo mappe interattive esterne traccianti in background. Cliccando sul pulsante "Apri in Google Maps" decidi tu se aprire l'applicazione sul tuo dispositivo.
              </p>
            </div>
          </div>

          <div class="p-3 bg-brand-ivory rounded-xl border border-brand-green/10 text-xs text-brand-charcoal/80 flex items-center justify-between">
            <span><strong>Orario di apertura serale:</strong> 18:30 – 22:30 (Sabato fino alle 23:00)</span>
            <span class="font-bold text-brand-terracotta">Mercoledì chiuso</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
