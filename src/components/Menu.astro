---
// Menu.astro
import { menuItems, menuCategories } from '../data/menu';
---

<section id="menu" class="py-12 sm:py-20 bg-[#FAF7F2] relative scroll-mt-28">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header & Toggle Button in the middle of page -->
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-6">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-green/10 text-brand-green text-xs sm:text-sm font-semibold uppercase tracking-wider">
        <span>Gusto & Tradizione</span>
      </div>
      
      <!-- Clickable Main Heading with Interactive Toggle Indicator -->
      <button 
        type="button" 
        id="menu-toggle-btn"
        aria-expanded="false"
        aria-controls="menu-expandable-content"
        class="group inline-flex flex-col items-center mx-auto focus:outline-none focus:ring-4 focus:ring-brand-terracotta/30 rounded-3xl p-3 sm:p-5 transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer"
      >
        <div class="flex items-center justify-center gap-3 sm:gap-4">
          <h2 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-brand-green group-hover:text-brand-terracotta tracking-tight transition-colors">
            Il Nostro Menù
          </h2>
          <!-- Modern animated pill indicator -->
          <div id="menu-toggle-chevron-box" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-brand-terracotta text-white flex items-center justify-center shadow-lg group-hover:bg-[#b04630] transition-transform duration-500">
            <svg id="menu-toggle-chevron" class="w-5 h-5 sm:w-6 sm:h-6 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </div>
        </div>

        <p class="text-brand-charcoal/80 text-sm sm:text-base font-medium mt-3 flex items-center gap-2">
          <span id="menu-toggle-status-text" class="text-brand-terracotta font-bold underline decoration-brand-yellow decoration-2 underline-offset-4 group-hover:text-[#b04630]">
            Clicca qui per visualizzare tutti i piatti e i prezzi
          </span>
          <span class="text-xs bg-brand-yellow/30 text-brand-charcoal px-2.5 py-0.5 rounded-full font-semibold">
            {menuItems.length} piatti
          </span>
        </p>
      </button>

      <p class="text-brand-charcoal/70 text-sm sm:text-base font-normal max-w-xl mx-auto">
        Dagli impasti a 48 ore di lievitazione ai classici primi romani e ai tagli di carne selezionata cotti alla brace.
      </p>
    </div>

    <!-- Expandable Content Wrapper (Collapsed by default) -->
    <div 
      id="menu-expandable-content"
      class="max-h-0 opacity-0 overflow-hidden transition-all duration-700 ease-in-out"
      aria-hidden="true"
    >
      <div class="pt-6 pb-4">
        
        <!-- Category Filter Tabs (SemiBold for categories) -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10" id="menu-tabs" role="tablist">
          {menuCategories.map((category, index) => (
            <button
              type="button"
              role="tab"
              data-filter={category.id}
              id={`tab-${category.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              class={`menu-filter-btn px-4 sm:px-6 py-2.5 rounded-full text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer shadow-sm ${
                index === 0
                  ? "bg-brand-green text-brand-ivory shadow-md"
                  : "bg-white text-brand-charcoal hover:bg-brand-green/10 hover:text-brand-green border border-brand-green/10"
              }`}
            >
              {category.label}
            </button>
          ))}
        </div>

        <!-- Mandatory Notice Banner for Allergens & Takeout -->
        <div class="mb-12 bg-white rounded-2xl p-5 sm:p-6 border-2 border-brand-yellow/60 shadow-md flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-4 text-center md:text-left">
            <div class="w-12 h-12 rounded-full bg-brand-yellow/20 flex items-center justify-center text-2xl flex-shrink-0">
              ℹ️
            </div>
            <div>
              <h3 class="font-bold text-brand-green text-base sm:text-lg">
                Ordini d'Asporto & Informazioni sugli Allergeni
              </h3>
              <p class="text-sm text-brand-charcoal/80 mt-0.5">
                Per ordini d'asporto o per qualsiasi richiesta su intolleranze ed ingredienti allergeni, chiamaci direttamente al 
                <a href="tel:0766370162" class="font-bold text-brand-terracotta underline hover:text-[#b04630]">0766 370162</a>. Saremo felici di aiutarti!
              </p>
            </div>
          </div>
          <a
            href="tel:0766370162"
            class="inline-flex items-center gap-2 bg-brand-terracotta hover:bg-[#b04630] text-white text-sm font-bold px-6 py-3 rounded-full shadow hover:shadow-warm-hover transform hover:-translate-y-0.5 active:translate-y-0 transition-all flex-shrink-0"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-brand-yellow" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 15.5c-1.2 0-2.4-.2-3.6-.6-.3-.1-.7 0-1 .2l-2.2 2.2c-2.8-1.4-5.1-3.8-6.6-6.6l2.2-2.2c.3-.3.4-.7.2-1-.4-1.1-.6-2.3-.6-3.5 0-.6-.4-1-1-1H4c-.6 0-1 .4-1 1 0 9.4 7.6 17 17 17 .6 0 1-.4 1-1v-3.5c0-.6-.4-1-1-1z"/>
            </svg>
            <span>Ordina al 0766 370162</span>
          </a>
        </div>

        <!-- Dishes Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="menu-grid">
          {menuItems.map((item) => (
            <article 
              class="menu-card bg-white rounded-2xl overflow-hidden border border-brand-green/10 shadow-warm hover:shadow-xl transition-all duration-300 flex flex-col group transform hover:-translate-y-1"
              data-category={item.category}
            >
              <!-- Dish Image with Fallback Placeholder Support -->
              <div class="relative w-full h-52 sm:h-56 overflow-hidden bg-brand-green/5">
                <img 
                  src={item.image} 
                  alt={item.name} 
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 rounded-t-2xl"
                  loading="lazy"
                  onerror="this.onerror=null; this.src='https://placehold.co/600x400/2E4B3C/F6F1E7?text=' + encodeURIComponent(this.alt);"
                />

                <!-- Category & Special Badges (SemiBold for categories) -->
                <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                  <span class="px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-brand-green/90 text-white backdrop-blur-sm shadow-sm">
                    {item.categoryLabel}
                  </span>
                  {item.popular && (
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-brand-yellow text-brand-charcoal shadow-sm">
                      ★ Consigliato
                    </span>
                  )}
                </div>

                <!-- Price Tag Overlay (Bold for secondary) -->
                <div class="absolute bottom-3 right-3 bg-brand-terracotta text-white font-bold text-lg px-3 py-1.5 rounded-xl shadow-lg">
                  {item.price}
                </div>
              </div>

              <!-- Dish Info -->
              <div class="p-6 flex-grow flex flex-col justify-between space-y-4">
                <div>
                  <div class="flex items-start justify-between gap-2 mb-2">
                    <!-- Titolo secondario (Bold) -->
                    <h3 class="font-bold text-xl text-brand-green group-hover:text-brand-terracotta transition-colors">
                      {item.name}
                    </h3>
                  </div>
                  <!-- Testo (Regular) -->
                  <p class="text-sm text-brand-charcoal/75 font-normal leading-relaxed">
                    {item.description}
                  </p>
                </div>

                <!-- Card Bottom Bar: Dietary badge + Quick Action -->
                <div class="pt-3 border-t border-brand-charcoal/10 flex items-center justify-between text-xs text-brand-charcoal/60">
                  <span class="inline-flex items-center gap-1 font-medium">
                    {item.vegetarian ? (
                      <span class="text-green-700 font-semibold">🌱 Vegetariano</span>
                    ) : (
                      <span>Tradizione Rainbow</span>
                    )}
                  </span>
                  <a 
                    href="tel:0766370162" 
                    class="font-bold text-brand-terracotta hover:underline inline-flex items-center gap-1"
                    aria-label={`Ordina ${item.name} chiamando il 0766 370162`}
                  >
                    <span>Ordina d'asporto</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Bottom Menu Reassurance Note & Close Action -->
        <div class="mt-12 flex flex-col items-center gap-6">
          <div class="text-center text-sm text-brand-charcoal/70 bg-brand-ivory p-4 rounded-xl border border-brand-green/15 max-w-2xl mx-auto w-full">
            <p>
              I nostri impasti sono preparati quotidianamente nel nostro laboratorio artigianale. 
              I prezzi sono comprensivi di coperto e servizio. Per richieste fuori menù del giorno o porzioni personalizzate, chiedi al nostro personale in sala o al telefono.
            </p>
          </div>

          <!-- Bottom Close Button -->
          <button
            type="button"
            id="menu-bottom-close-btn"
            class="inline-flex items-center gap-2 bg-brand-green hover:bg-[#233a2e] text-brand-ivory px-6 py-3 rounded-full font-bold text-sm shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 cursor-pointer"
          >
            <span>▲ Chiudi Menù</span>
          </button>
        </div>

      </div>
    </div>

  </div>
</section>

<script>
  // Menu Filtering Tabs Logic
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.menu-filter-btn');
  const menuCards = document.querySelectorAll<HTMLElement>('.menu-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button active state
      filterButtons.forEach((b) => {
        b.classList.remove('bg-brand-green', 'text-brand-ivory', 'shadow-md');
        b.classList.add('bg-white', 'text-brand-charcoal', 'border', 'border-brand-green/10');
        b.setAttribute('aria-selected', 'false');
      });

      btn.classList.remove('bg-white', 'text-brand-charcoal', 'border', 'border-brand-green/10');
      btn.classList.add('bg-brand-green', 'text-brand-ivory', 'shadow-md');
      btn.setAttribute('aria-selected', 'true');

      // Filter cards
      menuCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Expand / Collapse Menu Functionality
  const menuSection = document.getElementById('menu');
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const bottomCloseBtn = document.getElementById('menu-bottom-close-btn');
  const contentWrapper = document.getElementById('menu-expandable-content');
  const chevron = document.getElementById('menu-toggle-chevron');
  const statusText = document.getElementById('menu-toggle-status-text');

  let isMenuOpen = false;

  function openMenu() {
    if (isMenuOpen || !contentWrapper) return;
    isMenuOpen = true;
    contentWrapper.style.maxHeight = `${contentWrapper.scrollHeight + 100}px`;
    contentWrapper.classList.remove('opacity-0', 'max-h-0');
    contentWrapper.classList.add('opacity-100');
    contentWrapper.setAttribute('aria-hidden', 'false');
    toggleBtn?.setAttribute('aria-expanded', 'true');
    chevron?.classList.add('rotate-180');
    if (statusText) {
      statusText.textContent = 'Clicca per chiudere il menù';
    }
  }

  function closeMenu() {
    if (!isMenuOpen || !contentWrapper) return;
    isMenuOpen = false;
    contentWrapper.style.maxHeight = '0px';
    contentWrapper.classList.remove('opacity-100');
    contentWrapper.classList.add('opacity-0', 'max-h-0');
    contentWrapper.setAttribute('aria-hidden', 'true');
    toggleBtn?.setAttribute('aria-expanded', 'false');
    chevron?.classList.remove('rotate-180');
    if (statusText) {
      statusText.textContent = 'Clicca qui per visualizzare tutti i piatti e i prezzi';
    }
  }

  function toggleMenu() {
    if (isMenuOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  }

  toggleBtn?.addEventListener('click', toggleMenu);
  bottomCloseBtn?.addEventListener('click', () => {
    closeMenu();
    menuSection?.scrollIntoView({ behavior: 'smooth' });
  });

  // Open menu automatically when clicking any navigation link targeting #menu
  document.querySelectorAll('a[href$="#menu"]').forEach((link) => {
    link.addEventListener('click', (e) => {
      openMenu();
      // Smooth scroll with proper offset
      setTimeout(() => {
        menuSection?.scrollIntoView({ behavior: 'smooth' });
      }, 50);
    });
  });

  // Auto-close menu when scrolling completely above or completely below the menu section
  let isScrolling = false;
  window.addEventListener('scroll', () => {
    if (!isMenuOpen || !menuSection) return;
    if (isScrolling) return;

    isScrolling = true;
    requestAnimationFrame(() => {
      const rect = menuSection.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      const scrollY = window.scrollY;

      // Se l'utente torna in cima (ad esempio nella Hero o Header)
      const isCompletelyAbove = scrollY < 150;

      // Se l'utente scorre tutto giù verso la fine della pagina
      const isAtBottom = (windowHeight + scrollY) >= (document.documentElement.scrollHeight - 250);

      // O se la sezione menù è ormai completamente uscita dal viewport (sopra o sotto di oltre 400px)
      const isFarPastBelow = rect.bottom < -300;
      const isFarPastAbove = rect.top > (windowHeight + 300);

      if (isCompletelyAbove || isAtBottom || isFarPastBelow || isFarPastAbove) {
        closeMenu();
      }

      isScrolling = false;
    });
  }, { passive: true });
</script>
