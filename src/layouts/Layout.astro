---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { SITE_CONFIG } from '../utils/siteConfig';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "Pizzeria Rainbow | Pizzeria & Ristorante a Civitavecchia",
  description = "Pizzeria e ristorante a Civitavecchia. Pizze artigianali a lenta lievitazione, primi piatti della tradizione romana e carne alla brace. Prenota o ordina da asporto al 0766 370162.",
  canonicalUrl,
  ogImage = `${import.meta.env.BASE_URL}images/hero.jpg`,
} = Astro.props;

// Risoluzione URL canonico e Open Graph coerente con l'ambiente (GitHub Pages o dominio personalizzato)
const currentCanonical = canonicalUrl || (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `${SITE_CONFIG.officialDomain}${Astro.url.pathname}`);
const resolvedOgImage = ogImage.startsWith('http') 
  ? ogImage 
  : (Astro.site ? new URL(ogImage, Astro.site).href : `${SITE_CONFIG.officialDomain}${ogImage}`);

// Schema.org Restaurant Microdata conforme e validato, privo di dati inventati
const structuredData = {
  "@context": "https://schema.org",
  "@type": ["Restaurant", "FoodEstablishment"],
  "name": SITE_CONFIG.name,
  "image": resolvedOgImage,
  "telephone": SITE_CONFIG.telephone,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": SITE_CONFIG.address.streetAddress,
    "addressLocality": SITE_CONFIG.address.addressLocality,
    "addressRegion": SITE_CONFIG.address.addressRegion,
    "postalCode": SITE_CONFIG.address.postalCode,
    "addressCountry": SITE_CONFIG.address.addressCountry,
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": SITE_CONFIG.geo.latitude,
    "longitude": SITE_CONFIG.geo.longitude,
  },
  "url": currentCanonical,
  "servesCuisine": SITE_CONFIG.servesCuisine,
  "priceRange": SITE_CONFIG.priceRange,
  "openingHoursSpecification": SITE_CONFIG.openingHoursSpecification,
};
---

<!doctype html>
<html lang="it" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍕</text></svg>" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Pizzeria Rainbow" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={currentCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:url" content={currentCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Pizzeria Rainbow Civitavecchia" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- 
      NOTA DI ACCESSIBILITÀ E PRIVACY: 
      Google Fonts remoto è stato eliminato per tutelare la privacy ed evitare richieste a terze parti.
      Il font Montserrat è servito e ospitato localmente tramite src/fonts/ e global.css.
    -->

    <!-- Schema.org Restaurant Microdata -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-brand-ivory text-brand-charcoal antialiased min-h-screen flex flex-col selection:bg-brand-terracotta selection:text-white">
    <!-- Skip to Content for Accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 bg-brand-green text-brand-ivory px-4 py-2 rounded-lg shadow-lg font-medium focus:ring-2 focus:ring-brand-yellow focus:outline-none"
    >
      Vai al contenuto principale
    </a>

    <Header />

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <Footer />

    <!-- Pulsantino sempre presente in basso a destra per tornare a inizio pagina -->
    <BackToTop />

    <!-- Sticky Mobile Quick-Call Bar (Visible only on small screens) -->
    <aside 
      aria-label="Contatto rapido"
      class="fixed bottom-0 inset-x-0 bg-brand-green text-brand-ivory p-3 z-40 sm:hidden shadow-[0_-4px_15px_rgba(0,0,0,0.15)] flex items-center justify-between border-t border-brand-yellow/30"
    >
      <div class="flex items-center gap-2">
        <span class="relative flex h-3 w-3">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-yellow opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-brand-yellow"></span>
        </span>
        <span class="text-xs font-semibold uppercase tracking-wider text-brand-ivory/90">Aperti stasera dalle 18:30</span>
      </div>
      <a
        href="tel:0766370162"
        id="mobile-sticky-call-btn"
        class="inline-flex items-center gap-2 bg-brand-terracotta hover:bg-[#b04630] text-white text-sm font-bold px-4 py-2 rounded-full shadow-md active:scale-95 transition-all focus:outline-none focus:ring-2 focus:ring-brand-yellow"
        aria-label="Chiama Pizzeria Rainbow per prenotare o ordinare"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        <span>0766 370162</span>
      </a>
    </aside>
  </body>
</html>